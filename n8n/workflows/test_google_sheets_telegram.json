    "Switch (Decisión)": {
      "main": [
        [
          {
            "node": "Telegram: Confirmar Aprobado",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Telegram: Confirmar Rechazo",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
