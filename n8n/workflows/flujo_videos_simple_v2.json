{
  "name": "Proyecto Videos (Prueba Simple)",
  "nodes": [
    {
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300],
      "parameters": {
        "path": "test-video",
        "httpMethod": "POST",
        "responseMode": "onReceived",
        "options": {}
      }
    },
    {
      "name": "OpenAI (Guion)",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1,
      "position": [450, 300],
      "credentials": {
        "openAiApi": {
          "id": "openAi-cred-123",
          "name": "OpenAI account"
        }
      },
      "parameters": {
        "resource": "chat",
        "operation": "create",
        "model": "gpt-4o-mini",
        "messages": {
          "messageValues": [
            {
              "role": "user",
              "content": "={{$json.body.texto}}\n\nEscribe un pequeño guion de 15 palabras para un vídeo corto."
            }
          ]
        }
      }
    },
    {
      "name": "Wait (Aprobación)",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1,
      "position": [650, 300],
      "parameters": {
        "resume": "webhook",
        "options": {}
      }
    },
    {
      "name": "Telegram (Aprobación)",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [650, 100],
      "credentials": {
        "telegramApi": {
          "id": "telegram-cred-123",
          "name": "Bot2_Video_bot"
        }
      },
      "parameters": {
        "operation": "sendMessage",
        "chatId": "7156474626",
        "text": "={{ $('OpenAI (Guion)').item.json.message.content }}\n\n¿Apruebas este guion para generar la imagen?\n\nHaz clic aquí para aprobar: {{ $execution.resumeUrl }}"
      }
    },
    {
      "name": "OpenAI (DALL-E 3)",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1,
      "position": [850, 300],
      "credentials": {
        "openAiApi": {
          "id": "openAi-cred-123",
          "name": "OpenAI account"
        }
      },
      "parameters": {
        "resource": "image",
        "operation": "generate",
        "prompt": "={{ $('OpenAI (Guion)').item.json.message.content }}",
        "size": "1024x1024",
        "quality": "standard"
      }
    },
    {
      "name": "Telegram (Final)",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [1050, 300],
      "credentials": {
        "telegramApi": {
          "id": "telegram-cred-123",
          "name": "Bot2_Video_bot"
        }
      },
      "parameters": {
        "operation": "sendPhoto",
        "chatId": "7156474626",
        "file": "={{ $json.data[0].url }}",
        "caption": "¡Imagen generada con éxito por DALL-E 3!"
      }
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "OpenAI (Guion)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "OpenAI (Guion)": {
      "main": [
        [
          {
            "node": "Telegram (Aprobación)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Telegram (Aprobación)": {
      "main": [
        [
          {
            "node": "Wait (Aprobación)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Wait (Aprobación)": {
      "main": [
        [
          {
            "node": "OpenAI (DALL-E 3)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "OpenAI (DALL-E 3)": {
      "main": [
        [
          {
            "node": "Telegram (Final)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {}
}
