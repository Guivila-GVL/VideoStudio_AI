      "id": "ac8c403c-cd89-4e67-8b2a-161ae804d265"
    },
    {
      "parameters": {
        "jsCode": "\nlet history = \"\";\ntry {\n  let prevCode = $('Gestionar Historial').last();\n  let previousHistory = prevCode ? (prevCode.json.history || \"\") : \"\";\n  let lastDraft = $('OpenAI').last().json.message.content;\n  \n  let waitNode = $('Wait (Webhook Feedback)').last();\n  let feedback = \"Corregir (sin detalles)\";\n  if (waitNode && waitNode.json) {\n    feedback = (waitNode.json.query && waitNode.json.query.feedback) || (waitNode.json.body && waitNode.json.body.feedback) || feedback;\n  }\n  \n  history = previousHistory + \"\\n\\n--- INTENTO ANTERIOR ---\\n\" + lastDraft + \"\\n\\n--- FEEDBACK DEL USUARIO ---\\n\" + feedback;\n} catch (e) {\n  history = \"\"; // Primera ejecución\n}\nreturn { history: history };\n"
      },
      "name": "Gestionar Historial",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        200,
        0
      ],
      "id": "8e0ec99d-9621-4e74-85e9-9475ef4ced1f"
    },
    {
      "parameters": {
        "resource": "chat",
        "operation": "create",
        "model": "gpt-4o",
        "prompt": "={{ 'Texto original: ' + $('Google Sheets Trigger').first().json.Texto_Capitulo + '\\n\\n' + $json.history }}",
        "systemMessage": "Eres un director de vídeo experto. Divide el texto del usuario en escenas lógicas.\\n\\nReglas:\\n- Devuelve ÚNICAMENTE un objeto JSON puro (sin markdown, sin etiquetas ```json).\\n- El JSON debe tener una propiedad 'escenas' que sea un array.\\n- Cada escena debe tener:\\n  'narrador': el texto a locutar (español).\\n  'prompt_imagen': descripción visual ultra detallada (inglés).\\n\\nSi hay historial de intentos anteriores y feedback, adapta la nueva versión exactamente a las correcciones pedidas, manteniendo el formato JSON estricto.",
        "options": {
          "temperature": 0.7
        }
      },
      "name": "OpenAI",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1,
      "position": [
        400,
        0
      ],
      "id": "dcc7700f-f8b0-4e08-8df4-494aaee75add"
    },
