                  },
                  {
                    "text": "🔄 Regenerar escena",
                    "url": "http://127.0.0.1:8001/api/n8n/webhook/scene-decision?action=redo"
                  }
                ]
              }
            }
          ]
        }
      },
      "name": "Telegram: Enviar Medios (Audio/Img)",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.1,
      "position": [1800, 0]
    },
    {
      "parameters": {
        "resume": "webhook",
        "options": {}
      },
      "name": "Wait (Webhook 2)",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "webhookId": "UUID_2_AQUI",
