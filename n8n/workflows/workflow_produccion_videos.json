    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "id": "1",
                    "leftValue": "={{ $json.query.status }}",
                    "rightValue": "approved",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "Medios Aprobados"
            }
          ]
        }
      },
      "name": "Switch (Aprobación Medios)",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [2200, 0]
    },
    {
      "parameters": {
        "url": "URL_API_RUNWAY_O_LUMA",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"image_url\": \"{{ $json.image_url }}\",\n  \"prompt\": \"{{ $json.prompt }}\"\n}"
      },
      "name": "Runway / Luma API (Generar Vídeo)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [2500, 0]
    },
    {
      "parameters": {
        "command": "python d:/OneDrive/04_Desarrollo_proyectos/2026_Proyecto_Videos/ensamblar_video.py"
