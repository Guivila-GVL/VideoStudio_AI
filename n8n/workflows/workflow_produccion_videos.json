      "typeVersion": 1,
      "position": [400, 0]
    },
    {
      "parameters": {
        "operation": "update",
        "documentId": {
          "__rl": true,
          "value": "",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "",
          "mode": "id"
        }
      },
      "name": "Guardar Borrador en Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.1,
      "position": [600, 0]
    },
    {
      "parameters": {
        "chatId": "",
        "text": "Nuevo guion listo. Por favor revisa y aprueba para continuar con el audio e imágenes.",
        "replyMarkup": "inlineKeyboard",
        "inlineKeyboard": {
          "rows": [
            {
              "row": {
                "buttons": [
                  {
                    "text": "✅ Aprobar Guion",
                    "url": "URL_DEL_WEBHOOK_WAIT_AQUI?status=approved"
                  },
                  {
                    "text": "🔄 Regenerar",
                    "url": "URL_DEL_WEBHOOK_WAIT_AQUI?status=rejected"
                  }
                ]
              }
            }
          ]
        }
      },
      "name": "Telegram: Enviar Guion para Revisión",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.1,
      "position": [800, 0]
    },
    {
      "parameters": {
        "resume": "webhook",
        "options": {}
      },
      "name": "Wait (Webhook 1)",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "webhookId": "UUID_AQUI",
      "position": [1000, 0]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "id": "1",
                    "leftValue": "={{ $json.query.status }}",
                    "rightValue": "approved",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "Aprobado"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "id": "2",
                    "leftValue": "={{ $json.query.status }}",
                    "rightValue": "rejected",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "Rechazado"
            }
          ]
        }
      },
      "name": "Switch (Aprobación Guion)",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [1200, 0]
    },
    {
      "parameters": {
        "url": "https://api.elevenlabs.io/v1/text-to-speech/voice_id",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "xi-api-key",
              "value": "API_KEY"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"text\": \"{{ $json.text }}\",\n  \"model_id\": \"eleven_multilingual_v2\"\n}"
      },
      "name": "ElevenLabs API (Generar Voz)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1500, -100]
    },
    {
      "parameters": {
        "url": "URL_API_MIDJOURNEY_O_STABLE_DIFFUSION",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"prompt\": \"{{ $json.prompt }} --cref URL_PERSONAJE\"\n}"
      },
      "name": "Generador de Imágenes API (Midjourney)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1500, 100]
